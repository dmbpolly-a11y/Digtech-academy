# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the client

# ---- Pandora Payments ----
PANDORA_API_BASE_URL=https://api.pandorapayments.example
PANDORA_MERCHANT_ID=your-merchant-id
PANDORA_API_KEY=your-pandora-api-key
PANDORA_WEBHOOK_SECRET=your-webhook-signing-secret

# ---- Digtech SMS API ----
DIGTECH_SMS_BASE_URL=https://sms.digtech.example/api
DIGTECH_SMS_API_KEY=your-sms-api-key
DIGTECH_SMS_SENDER_ID=DIGTECH

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
